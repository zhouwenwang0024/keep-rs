# ============================================
# Rust Keeper Bots - Filler 配置示例
# ============================================
# 复制此文件为 .env 并填入实际值
#
# 使用方法：
#   cp .env.example .env
#   然后编辑 .env 文件，填入实际的配置值

# ============================================
# 必需配置（Filler 启动必需）
# ============================================

# 机器人钱包私钥（Base58 编码）
# 位置: src/main.rs:153
# 注意：永远不要将此私钥提交到版本控制系统
BOT_PRIVATE_KEY="your_base58_private_key_here"
RPC_SKIP_PREFLIGHT=false
# Pyth 价格源访问令牌
# 位置: src/filler.rs:139
# 用于订阅 Pyth 价格更新，Filler 必需此令牌才能获取价格数据
PYTH_LAZER_TOKEN="your_pyth_token_here"

# ============================================
# 推荐配置（有默认值但建议设置）
# ============================================

# Solana RPC 端点
# 位置: src/main.rs:172
# 默认值: "https://api.devnet.solana.com"
# 主网建议使用高性能 RPC 服务商（如 Helius、QuickNode、Triton）
# 示例：
#   RPC_URL="https://api.mainnet-beta.solana.com"
#   RPC_URL="https://your-rpc-provider.com"
RPC_URL="https://api.mainnet-beta.solana.com"

# Prometheus 指标服务器端口
# 位置: src/main.rs:124
# 默认值: 9898
# 用于暴露 Prometheus 指标，可通过 http://localhost:9898/metrics 访问
# METRICS_PORT=9898

# ============================================
# Jito 配置（可选，用于交易打包）
# ============================================
# 注意：如果不设置任何 Jito UUID，系统将不使用 Jito，只通过普通 RPC 发送交易

# Jito UUID 列表（逗号分隔，推荐方式）
# 位置: src/jito_sender.rs:17
# 系统会轮询使用这些 UUID（round-robin）
# 示例: JITO_UUIDS="uuid1,uuid2,uuid3"
# JITO_UUIDS="your_jito_uuid1,your_jito_uuid2"

# 或使用单个 UUID 变量（可以混合使用，会自动合并去重）
# 位置: src/jito_sender.rs:25
# 系统会检查 JITO_UUID1, JITO_UUID2, JITO_UUID 三个环境变量
# JITO_UUID1="your_jito_uuid1"
# JITO_UUID2="your_jito_uuid2"
# JITO_UUID="your_jito_uuid"

# Jito bundles API URL
# 位置: src/jito_sender.rs:38
# 默认值: "https://tokyo.mainnet.block-engine.jito.wtf/api/v1/bundles"
# 主网默认使用东京节点，可根据需要修改为其他区域
# JITO_BUNDLES_URL="https://tokyo.mainnet.block-engine.jito.wtf/api/v1/bundles"

# Jito tip 账户地址
# 位置: src/tx_worker.rs:71
# 默认值: "HFqU5x63VTqvQss8hp11i4wVV8bD44PvwucfZ2bU7gRe"
# 用于向 Jito 验证者支付小费
# JITO_TIP_ACCOUNT="HFqU5x63VTqvQss8hp11i4wVV8bD44PvwucfZ2bU7gRe"

# Jito tip 金额（lamports）
# 位置: src/tx_worker.rs:79
# 默认值: 10000 (0.00001 SOL)
# 每次发送 bundle 时支付给 Jito 验证者的小费
# JITO_TIP_LAMPORTS=10000

# ============================================
# 基础配置（可通过环境变量或命令行参数设置）
# ============================================

# 市场 ID 列表（逗号分隔）
# 位置: src/main.rs:49
# 默认值: "0,1,2"
# Filler 将只在这些市场上运行
# 示例: MARKET_IDS="0,1,2,3,4"
# MARKET_IDS="0,1,2"

# 是否使用主网（true/false）
# 位置: src/main.rs:52
# 默认值: "true"
# 设置为 "false" 将使用 devnet
# MAINNET=true

# 是否仅模拟交易（不发送真实交易）
# 位置: src/main.rs:60
# 默认值: "false"
# 设置为 "true" 时，只模拟交易，不会真正发送到链上（用于测试）
# DRY_RUN=false

# Filler 子账户 ID
# 位置: src/main.rs:62
# 默认值: "0"
# Filler 使用的子账户索引
# SUB_ACCOUNT_ID=0

# ============================================
# Swift/On-chain Fill 配置
# ============================================

# Swift 订单计算单元限制
# 位置: src/main.rs:56
# 默认值: 364000
# Swift 订单填充交易的计算单元上限
# SWIFT_CU_LIMIT=364000

# Fill 交易计算单元限制
# 位置: src/main.rs:58
# 默认值: 256000
# On-chain 订单填充交易的计算单元上限
# FILL_CU_LIMIT=256000

# ============================================
# JIT 策略配置
# ============================================
# JIT (Just-In-Time) 策略用于在订单成交前临时提供流动性

# 是否启用 JIT 策略
# 位置: src/main.rs:65
# 默认值: "true"
# 设置为 "false" 将禁用 JIT 功能
# JIT_ENABLED=true

# JIT 子账户 ID
# 位置: src/main.rs:68
# 默认值: "1"
# JIT 策略使用的子账户索引（应与 Filler 子账户不同）
# JIT_SUB_ACCOUNT_ID=1

# JIT 边缘阈值（1e6 = 100%，即 5000 = 0.5%）
# 位置: src/main.rs:71
# 默认值: 5000 (0.5%)
# JIT 订单的最小利润边缘，单位是百万分之一（ppm）
# 例如：5000 = 0.5%, 10000 = 1%
# JIT_EDGE_PPM=5000

# JIT 每边最大 maker 数量
# 位置: src/main.rs:74
# 默认值: 3
# JIT 订单每边（买单/卖单）最多选择的 maker 数量
# JIT_MAX_MAKERS_PER_SIDE=3

# JIT 冷却时间（毫秒）
# 位置: src/main.rs:77
# 默认值: 5
# 同一市场两次 JIT 尝试之间的最小时间间隔
# JIT_COOLDOWN_MS=5

# JIT 价格过期时间（毫秒）
# 位置: src/main.rs:80
# 默认值: 1500
# 价格数据被认为过期的最大时间（超过此时间的价格不会用于 JIT）
# JIT_PRICE_STALE_MS=1500

# JIT 计算单元限制
# 位置: src/main.rs:83
# 默认值: 256000
# JIT 交易的计算单元上限
# JIT_CU_LIMIT=256000

# JIT proxy 程序 ID（可选）
# 位置: src/main.rs:86
# 默认值: ""（空字符串，使用默认程序）
# 如果使用自定义 JIT proxy 程序，在此设置程序 ID
# JIT_PROXY_PROGRAM_ID=""

# ============================================
# 配置说明
# ============================================
#
# 1. Jito UUID 配置方式：
#    - 可以使用 JITO_UUIDS（逗号分隔列表，推荐）
#    - 或使用 JITO_UUID1, JITO_UUID2, JITO_UUID（单个变量）
#    - 可以混合使用，代码会自动合并并去重
#    - 如果不设置任何 UUID，系统不会使用 Jito
#
# 2. 配置优先级：
#    - 环境变量和命令行参数都可以设置
#    - 命令行参数优先级更高（如果同时设置）
#
# 3. 必需配置：
#    - BOT_PRIVATE_KEY 和 PYTH_LAZER_TOKEN 是启动 Filler 的必需项
#    - 其他配置都有默认值，但建议根据实际情况调整
#
# 4. 安全提示：
#    - 永远不要将包含真实私钥的 .env 文件提交到版本控制系统
#    - 确保 .env 文件权限设置正确（建议 600）
#    - 定期轮换 API 令牌和私钥
